# Save a private copy as supabase/functions/.env, then upload via CLI.
# These values are ONLY for Supabase Edge Function secrets, never browser JS.
LEAGUE_BOT_SECRET=YOUR_SHARED_SECRET_MATCHING_BOT_FRONTLINE_API_KEY
DISCORD_TOKEN=YOUR_ROTATED_BOT_TOKEN
DISCORD_GUILD_ID=YOUR_DISCORD_SERVER_ID
FOUNDER_ROLE_ID=YOUR_FOUNDER_ROLE_ID
STAFF_ROLE_ID=YOUR_STAFF_ROLE_ID
GM_ROLE_ID=YOUR_GM_ROLE_ID
LEAGUE_ALLOWED_ORIGINS=https://frontlinecodleague.com,https://www.frontlinecodleague.com
# Supabase supplies SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_DB_URL.
# Optional only if the built-in DB URL cannot connect:
# LEAGUE_DATABASE_URL=YOUR_SUPABASE_CONNECTION_URI
# LEAGUE_DATABASE_CA=YOUR_DATABASE_ROOT_CERTIFICATE_PEM
