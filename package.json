{
  "name": "frontline-call-of-duty-league",
  "version": "1.0.0",
  "description": "Frontline CDL web application with Supabase backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "echo 'No build step required'",
    "test": "node --test league/test/*.test.cjs",
    "test:edge-db": "node league/test/run-edge-db.cjs",
    "test:switch": "node --test switch/test/*.test.cjs",
    "test:veto": "node --test veto/test/*.test.cjs",
    "test:match-fixes": "node --test match-fixes/test/*.test.cjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "4.21.2",
    "pg": "8.13.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1"
  }
}
