# OPTIONAL local Node server only. GitHub Pages does not load this file.
# Production Edge secrets: see supabase/functions/.env.example and LEAGUE_BOT_SETUP.md.

# PostgreSQL / Supabase Connection String
# Get this from Supabase -> Project Settings -> Database -> Connection URI (Transaction/Session Pooler)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Port for local server
PORT=3000

# Website and bot must use the SAME Supabase database.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_public_supabase_anon_key
LEAGUE_BOT_SECRET=generate_a_long_random_shared_secret
DISCORD_TOKEN=your_new_bot_token
DISCORD_GUILD_ID=your_server_id
FOUNDER_ROLE_ID=your_founder_role_id
STAFF_ROLE_ID=your_staff_role_id
GM_ROLE_ID=your_gm_role_id
